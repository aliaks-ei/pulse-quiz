{
  "name": "hb-trivia-game",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "analyze": "ANALYZE=true vite build",
    "format": "prettier . --write --ignore-unknown",
    "prepare": "husky",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "media:reap-orphans": "node --import tsx --env-file-if-exists=.env scripts/reap-orphans.ts",
    "media:migrate-to-r2": "node --import tsx --env-file-if-exists=.env scripts/migrate-media-to-r2.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "@vueuse/core": "^14.2.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.511.0",
    "motion-v": "^2.2.0",
    "pinia": "^3.0.1",
    "qrcode": "^1.5.4",
    "swiper": "^12.2.0",
    "tailwind-merge": "^2.5.5",
    "vue": "^3.5.13",
    "vue-i18n": "^11.3.2",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^26.3.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "aws4fetch": "1.0.20",
    "eslint": "10.9.1",
    "eslint-plugin-vue": "10.10.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.3",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "supabase": "2.115.0",
    "tailwindcss": "^4.1.3",
    "tsx": "4.23.12",
    "typescript": "~7.0.2",
    "typescript-eslint": "8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.2",
    "vue-tsc": "^3.3.11"
  }
}
