# Supabase browser client
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_your_publishable_key

# Public app origin (local Vite dev server)
VITE_APP_URL=http://localhost:5175

# Cloudflare Turnstile sitekey for anonymous sign-ins and magic links.
# The value below is Cloudflare's "always passes" test sitekey, which pairs
# with the test secret in supabase/config.toml. Replace both with a real widget
# in production. Leave empty to skip the captcha entirely.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Cloudflare R2 question media (Supabase Edge Function secrets, never Vite variables)
# npx supabase secrets set R2_ACCOUNT_ID=... R2_ACCESS_KEY_ID=... R2_SECRET_ACCESS_KEY=... R2_BUCKET=pulse-quiz-question-media
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Maintenance scripts only (npm run media:reap-orphans, npm run media:migrate-to-r2)
SUPABASE_SERVICE_ROLE_KEY=
